# Skopiuj do .env i wypełnij:  cp .env.example .env
#
# Sekrety generuj losowo, nie wymyślaj:
#   openssl rand -base64 48

# --- baza (tylko docker-compose.yml, czyli stos z lokalnym Postgresem) ----
POSTGRES_DB=easy_gym
POSTGRES_USER=easy_gym
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- baza zewnętrzna (tylko docker-compose.prod.yml) ---------------------
# DB_URL=jdbc:postgresql://ep-xxxx.eu-central-1.aws.neon.tech/easy_gym?sslmode=require
# DB_USERNAME=
# DB_PASSWORD=

# --- backend -------------------------------------------------------------
# Klucz HMAC do podpisywania access tokenów. Zmiana = wylogowanie wszystkich.
JWT_SECRET=
# Sekret do POST /api/admin/users (zakładanie kont). Nie trafia do frontu.
ADMIN_BOOTSTRAP_SECRET=
# Origin(y) frontu dopuszczone w CORS, po przecinku.
CORS_ALLOWED_ORIGINS=http://localhost:3000
BACKEND_PORT=8080

# --- frontend ------------------------------------------------------------
# Adres API widziany Z PRZEGLĄDARKI (nie z sieci dockerowej!) -- wchodzi do
# bundla w czasie builda, po zmianie: docker compose build frontend.
NEXT_PUBLIC_API_URL=http://localhost:8080
FRONTEND_PORT=3000

# Tag obrazów (przydatne przy deployu z rejestru).
IMAGE_TAG=local
